# Door to Door environment variables: a checklist of what to export, with
# placeholders only. Never put real values in this file or commit them.
#
# Settings live in config.yaml (copy config.example.yaml). Only secrets and
# process plumbing are environment variables; README.md, "Environment
# variables", says what each one does.
#
# Export them in the shell that runs the app or a db:* script. Next (dev,
# build) and drizzle-kit (db:generate, db:push, db:studio) would also read a
# .env file, but db:migrate, db:seed and db:reset never do, and the server
# warns when it finds one (D-75-16). One way to keep them in a file: copy this
# outside the repository, fill it in, and load it into each shell with
#
#   set -a; . ~/door-to-door.env; set +a
#
# An empty value counts as unset.

# --- Secrets ------------------------------------------------------------------
# Never commit them, never put them in config.yaml. Each also has a _FILE
# variant naming a file to read it from (a trailing newline is dropped); set
# one or the other, not both (D-75-2).

# Required by the app and the db:* scripts. Added to database.url,
# percent-encoded for you. postgres/postgres matches the quick start.
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Required by the app. 32+ random characters, not a placeholder (D-75-6):
#   openssl rand -base64 32
AUTH_SECRET=

# Only once auth.google.clientId is set in config.yaml (reserved for #14).
# AUTH_GOOGLE_SECRET=

# Example of the _FILE form, as Docker and Kubernetes secrets arrive:
# AUTH_SECRET_FILE=/run/secrets/auth_secret

# --- Not secret, all optional -------------------------------------------------
# Defaults shown. The test URLs carry credentials, but only for throwaway local
# databases.

# Where the settings file is (/app/config.yaml in the image).
# CONFIG_PATH=./config.yaml

# Public URL, read by Auth.js itself; only needed with auth.trustHost: false.
# AUTH_URL=https://door-to-door.example.com

# Where the standalone server listens (HOSTNAME is 0.0.0.0 in the image).
# PORT=3000
# HOSTNAME=0.0.0.0

# Set by Next; production in the image.
# NODE_ENV=production

# Opts out of Next.js telemetry (1 in the image).
# NEXT_TELEMETRY_DISABLED=1

# Compose only: which settings file to mount.
# CONFIG_FILE=./config.docker.yaml

# Compose only: watch files by polling, for bind mounts on macOS and Windows.
# WATCHPACK_POLLING=true
# CHOKIDAR_USEPOLLING=true

# Tests only, and required by test:integration, test:all and test:coverage.
# Its tables are truncated, so never point it at real data (D-75-8).
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/door_to_door_test

# E2E only: created and reseeded on every run.
# E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/door_to_door_e2e

# E2E only: the port the suite serves the build on.
# E2E_PORT=3210

# Offline sync fuzz test: replay or extend it (defaults 34 and 150). The test
# has a fixed 30-second timeout, so keep FC_RUNS to a few hundred.
# FC_SEED=7
# FC_RUNS=400

# Playwright: forbids test.only, never reuses a running server, GitHub reporter.
# CI=true
