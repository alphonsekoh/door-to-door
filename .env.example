# Environment variables for Door to Door. Placeholders only - never commit real values.
#
# The app does NOT read a .env file for its settings (D-75-16): settings live in
# config.yaml (copy config.example.yaml), and only secrets and process plumbing come
# from the environment. If a file named .env exists, the server prints a warning at
# startup, and `npm run db:migrate` / `db:seed` never read it. So treat this file as a
# checklist of what to export, not as something to copy to .env. For local work:
#
#   cp .env.example .env.local     # git-ignored; edit the values
#   set -a; . ./.env.local; set +a  # export them into this shell
#
# Every secret below also accepts a NAME_FILE variant naming a file to read it from
# (a trailing newline is dropped) - the Docker and Kubernetes secrets pattern. Set one
# or the other, never both: both set is a startup error.

# ---------------------------------------------------------------- secrets (required)

# Added to database.url from config.yaml (which must not contain credentials).
# Or: DATABASE_USER_FILE / DATABASE_PASSWORD_FILE.
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Signs the session cookie (JWT). At least 32 random characters; anything shorter,
# or anything that looks like a placeholder, stops the server at startup.
# Generate one with: openssl rand -base64 32
# Or: AUTH_SECRET_FILE.
AUTH_SECRET=

# ---------------------------------------------------------------- secrets (optional)

# Google client secret. Required only once auth.google.clientId is set in config.yaml.
# Google sign-in itself (#14) is not built yet, so leave this unset.
# Or: AUTH_GOOGLE_SECRET_FILE.
# AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------- runtime (optional)

# Where the settings file is. Default ./config.yaml (relative to the working
# directory); /app/config.yaml in the Docker image.
# CONFIG_PATH=./config.yaml

# The app's public URL, read by Auth.js itself (not by this codebase). Only needed
# when auth.trustHost is false in config.yaml; behind a proxy, leave it unset.
# AUTH_URL=https://door-to-door.example.org

# Where the standalone server listens. Default 3000 and all interfaces in the image.
# PORT=3000
# HOSTNAME=0.0.0.0

# ---------------------------------------------------------------- docker compose only

# Which settings file `docker compose up` mounts. Default ./config.docker.yaml.
# CONFIG_FILE=./config.docker.yaml

# ---------------------------------------------------------------- tests only

# Integration tests: a full URL, credentials included, for a throwaway database.
# The suite truncates tables, so never point this at real data.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/door_to_door_test

# End-to-end tests (all optional). Defaults shown.
# E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/door_to_door_e2e
# E2E_PORT=3210

# Offline sync fuzz: replay or extend the property test.
# FC_SEED=7
# FC_RUNS=2000
