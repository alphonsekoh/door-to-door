{
  "name": "door-to-door",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "postbuild": "tsx scripts/check-standalone.ts",
    "start": "npm run start:standalone",
    "lint": "next typegen && eslint .",
    "lint:fix": "next typegen && eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project components",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:components": "vitest run --project components",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "postdb:generate": "tsx scripts/record-migration-checksums.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "db:check-blank": "tsx scripts/check-blank-text.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "test:all": "vitest run",
    "spec:lint": "redocly lint openapi.yaml",
    "spec:preview": "redocly build-docs openapi.yaml -o .next/api-docs.html",
    "generate:api": "openapi-ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:linux": "bash scripts/e2e-linux.sh",
    "start:standalone": "cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static && if [ -n \"$CONFIG_YAML\" ]; then node .next/standalone/server.js; else CONFIG_PATH=\"${CONFIG_PATH:-$PWD/config.yaml}\" node .next/standalone/server.js; fi",
    "icons": "tsx scripts/generate-icons.ts",
    "stage:up": "docker compose -p door-to-door-stage -f docker-compose.stage.yml up -d --build --wait",
    "stage:seed": "docker compose -p door-to-door-stage -f docker-compose.stage.yml run --rm --build seed",
    "stage:perf": "tsx scripts/stage-perf.ts",
    "stage:logs": "docker compose -p door-to-door-stage -f docker-compose.stage.yml logs",
    "stage:psql": "docker compose -p door-to-door-stage -f docker-compose.stage.yml exec db psql -U stage door_to_door_stage",
    "stage:down": "docker compose -p door-to-door-stage -f docker-compose.stage.yml down -v"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@node-rs/argon2": "^2.2.2",
    "@serwist/turbopack": "^9.5.13",
    "@vercel/functions": "3.11.3",
    "drizzle-orm": "^0.45.4",
    "esbuild-wasm": "^0.28.2",
    "idb": "^8.0.4",
    "motion": "14.10.1",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serwist": "^9.5.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.65.0",
    "@redocly/cli": "^2.76.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "zod": "$zod"
  }
}
