#!/usr/bin/env bash
# The Linux E2E gate (#201). Before a push leaves this machine, CI's E2E job
# runs on each pushed commit in a Linux container (scripts/e2e-linux.sh), so a
# failure costs local minutes instead of Actions minutes. Enable it once per
# clone, for every worktree:
#
#   git config core.hooksPath .githooks
#
# Skipped: branch deletions, pushes that change only docs (docs/, a top-level
# *.md or .claude/), and trees that have passed a whole-suite run, or differ
# from one only in docs. SKIP_E2E_LINUX=1 skips it for one push; CI still runs
# the suite.
set -euo pipefail

if [ "${SKIP_E2E_LINUX:-}" = 1 ]; then
  echo "pre-push: SKIP_E2E_LINUX=1, so the Linux E2E gate is skipped (CI still runs it)" >&2
  exit 0
fi

root=$(git rev-parse --show-toplevel)
passed="$(git rev-parse --path-format=absolute --git-common-dir)/e2e-linux-passed"
zero=0000000000000000000000000000000000000000
# Paths no E2E test reads.
docs='^docs/|^[^/]+\.md$|^\.claude/'

only_docs() {
  [ -n "$1" ] && ! printf '%s\n' "$1" | grep -qvE "$docs"
}

# Its tree passed, or differs from a recent tree that passed only in docs.
has_passed() {
  local tree t
  [ -f "$passed" ] || return 1
  tree=$(git rev-parse "$1^{tree}")
  ! grep -q "^$tree " "$passed" || return 0
  for t in $(tail -n 50 "$passed" | cut -d ' ' -f 1); do
    ! only_docs "$(git diff --name-only "$t" "$tree" 2>/dev/null)" || return 0
  done
  return 1
}

todo=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" != "$zero" ] || continue
  ! has_passed "$local_sha" || continue
  # What this push adds: since the remote's tip, or for a new branch since
  # main. With neither known, everything counts.
  base=""
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base=$remote_sha
  else
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
  fi
  if [ -n "$base" ]; then
    changed=$(git diff --name-only "$base" "$local_sha")
    [ -n "$changed" ] || continue
    ! only_docs "$changed" || continue
  fi
  todo+=("$local_sha")
done

for sha in ${todo[@]+"${todo[@]}"}; do
  # A second ref at the same tree passed with the first.
  ! has_passed "$sha" || continue
  echo "pre-push: running the Linux E2E gate on $(git rev-parse --short "$sha"), about 10 minutes (SKIP_E2E_LINUX=1 skips it)" >&2
  if ! "$root/scripts/e2e-linux.sh" --ref "$sha" </dev/null; then
    echo "pre-push: the Linux E2E gate failed, so nothing was pushed" >&2
    exit 1
  fi
done
